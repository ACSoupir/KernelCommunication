\strong{Built-in Distance Methods:}
\itemize{
  \item \code{"euclidean"}: \eqn{\sqrt{(x_i - x_j)^2 + (y_i - y_j)^2}}
  \item \code{"manhattan"}: \eqn{|x_i - x_j| + |y_i - y_j|}
